{
  "name": "poe2-crafting-assistant",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "description": "POE2 Crafting Assistant - planejamento, cálculo e tutorial de crafting para Path of Exile 2",
  "license": "MIT",
  "author": "MarcelloBF",
  "repository": {
    "type": "git",
    "url": "https://github.com/MarcelloBF/poe2-crafting-assistant.git"
  },
  "homepage": "https://marcellobf.github.io/poe2-crafting-assistant/",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "data:download": "node scripts/import-repoe.mjs --download",
    "data:import": "node scripts/import-repoe.mjs",
    "prices:update": "node scripts/update-prices.mjs",
    "app": "npm run build && electron .",
    "app:dist": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tesseract.js": "^5.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "build": {
    "appId": "io.github.poe2craftingassistant",
    "productName": "POE2 Crafting Assistant",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "MarcelloBF",
      "repo": "poe2-crafting-assistant",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "POE2-Crafting-Assistant-Setup-${version}.${ext}"
    }
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
